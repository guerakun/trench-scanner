# Copy to .env and fill in. .env is git-ignored and must never be committed.
# These values are uploaded to the Cloudflare Worker as secrets (wrangler secret put ...).
# The browser page never sees them.

# TypeSafe (Jev) - https://api.typesafe.ai/v1/systemone, model jev-latest
TYPESAFE_API_KEY=

# twitterapi.io - optional X/Twitter layer
TWITTERAPI_IO_KEY=
